plugins {
  id 'nf-schema@2.5.1'
}

validation {
  lenientMode = true
  logging {
    unrecognisedParams = "error"
  }
}

// Global default params. User run settings should normally come from -params-file.
params {
  // required inputs
  ref_h5ad = ""
  query_h5ad = ""
  project_tag = ""
  outdir = ""
  ref_label_col = ""
  batch_key = null
  ref_filter_col = ""
  ref_filter_values = ""

  // optional model reuse
  celltypist_model = ""
  scanvi_model_dir = ""
  scvi_reference_model_dir = ""

  // output column names
  scanvi_obs_col = "scanvi_label"
  scanvi_score_col = "scanvi_confidence"
  query_cluster_col = "leiden"
  compute_missing_clusters = false
  marker_genes_n_top = 50
  marker_genes_method = "wilcoxon"
  marker_dotplot = true
  marker_dotplot_n_top = 5
  unknown_label = "Unknown"
  scanvi_hvg_n_top_genes = 2500
  scvi_training_config = ""

  // scVI/scANVI setup controls ignored when scvi_training_config is provided
  scvi_layer = null
  scanvi_categorical_covariate_keys = ""
  scanvi_continuous_covariate_keys = ""

  // scVI model controls ignored when scvi_training_config is provided
  scvi_n_hidden = null
  scvi_n_latent = null
  scvi_n_layers = null
  scvi_dropout_rate = null
  scvi_dispersion = null
  scvi_gene_likelihood = null
  scvi_latent_distribution = null

  // SCVI.train controls ignored when scvi_training_config is provided
  scvi_train_max_epochs = null
  scvi_train_batch_size = null
  scvi_train_train_size = null
  scvi_train_validation_size = null
  scvi_train_early_stopping = null
  scvi_train_early_stopping_patience = null

  // SCANVI.train controls ignored when scvi_training_config is provided
  scanvi_train_max_epochs = null
  scanvi_train_batch_size = null
  scanvi_train_train_size = null
  scanvi_train_validation_size = null
  scanvi_train_early_stopping = null
  scanvi_train_early_stopping_patience = null

  // Query-mapping SCANVI.train controls ignored when scvi_training_config is provided
  scanvi_query_max_epochs = 100
  scanvi_query_batch_size = null
  scanvi_query_train_size = null
  scanvi_query_validation_size = null
  scanvi_query_early_stopping = null
  scanvi_query_early_stopping_patience = null
  scanvi_query_check_val_every_n_epoch = 10
  scanvi_query_plan_weight_decay = 0.0

  panhumanpy_feature_names_col = ""

  // CellTypist training controls
  celltypist_training_mode = "detailed"
  celltypist_balance_cells_per_label = 500
  celltypist_feature_selection = true
  celltypist_feature_selection_top_genes = 100
  celltypist_feature_selection_max_iter = 5
  celltypist_max_iter = 100
}

// Configuring LSF job submission parameters for each process
executor {
  name = 'lsf'
  perJobMemLimit = true
}

singularity {
  enabled     = true
  autoMounts  = true
  cacheDir = '/nfs/cellgeni/singularity/images/'
  runOptions = '-B /lustre,/nfs --nv'
}

process {
  container = '/nfs/cellgeni/singularity/images/autoannotate-0.1.0.sif'

  errorStrategy = { task.exitStatus == 130 ? 'retry' : 'terminate' }
  maxRetries    = 5

  withLabel: normal {
    queue = "normal"
    cpus = 1
    memory = { 16.GB * task.attempt }
  }

  withLabel: validation {
    queue = "normal"
    cpus = 1
    memory = { 4.GB * task.attempt }
  }

  withLabel: cpu4 {
    queue = "normal"
    cpus = 4
    memory = { 8.GB * task.attempt }
  }

  withLabel: gpu {
    queue = "gpu"
    cpus = 1
    memory = { 32.GB * task.attempt }
    clusterOptions = { '-gpu "mode=shared:j_exclusive=no:gmem=16000:num=1"' }
  }

  withName: SCANVI_ANNOTATE {
    memory = { 64.GB * task.attempt }
  }

  withName: PANHUMANPY_ANNOTATE {
    container = '/nfs/cellgeni/singularity/images/autoannotate-0.1.0-phpy.sif'
  }
}

// Capture exit codes from upstream processes when piping
process.shell = ['/bin/bash', '-euo', 'pipefail']

// Capturing Nextflow log files into a reports directory
def timestamp = new java.util.Date().format('yyyyMMdd_HHmm')
timeline {
  enabled = true
  file = "autoannotate-reports-${params.project_tag}/timeline_${timestamp}.html"
}

report {
  enabled = true
  file = "autoannotate-reports-${params.project_tag}/report_${timestamp}.html"
}

trace {
  enabled = true
  file = "autoannotate-reports-${params.project_tag}/trace-${timestamp}.txt"
  fields = "task_id,hash,name,status,exit,submit,duration,realtime,%cpu,memory,%mem,peak_rss,peak_vmem"
}

workDir = "nf-work"
